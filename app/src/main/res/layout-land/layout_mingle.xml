<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/CardView.Light.NEW"
    android:layout_width="match_parent"
    android:id="@+id/cardWith"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginHorizontal="5dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:orientation="vertical"
    app:cardCornerRadius="10dp"
    android:elevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/CardView.Light.NEW"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:elevation="0dp"
            app:strokeWidth="0dp"
            android:layout_height="300dp"
            app:cardCornerRadius="5dp">
            <ImageView
                android:layout_width="match_parent"
                android:id="@+id/profileImage"
                android:layerType="software"
                android:layout_gravity="bottom|end"
                android:scaleType="center"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_width="60dp"
                android:layout_gravity="bottom|right"
                android:layout_margin="2dp"
                android:id="@+id/verify"
                android:src="@drawable/star_border"
                android:layout_height="60dp"
                app:tint="@color/darkGreen" />

        </com.google.android.material.card.MaterialCardView>






        <TextView
            android:id="@+id/username"
            style="@style/Base.Widget.AppCompat.TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="marquee"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:text="Thabelo Nevhuduli"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/country"
                style="@style/Base.Widget.AppCompat.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:maxWidth="140dp"
                android:maxLines="1"
                android:layout_gravity="center_vertical"
                android:text="South Africa"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/age"
                style="@style/Base.Widget.AppCompat.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:maxWidth="140dp"
                android:layout_gravity="center_vertical"
                android:maxLines="1"
                android:text="20"
                android:layout_marginStart="5dp"
                android:textSize="16sp"
                android:textStyle="bold" />
            <androidx.cardview.widget.CardView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:backgroundTint="@color/Gray"
                android:id="@+id/onlineStatus"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="7dp"
                app:cardCornerRadius="100dp"/>

        </LinearLayout>
        <TextView
            android:layout_width="140dp"
            android:maxWidth="200dp"
            android:textSize="14sp"
            android:id="@+id/cityandtown"
            android:maxLines="2"
            android:ellipsize="marquee"
            android:layout_marginTop="2dp"
            android:text="Limpopo,Nzhelele"
            android:layout_height="wrap_content">

        </TextView>
    </LinearLayout>


</com.google.android.material.card.MaterialCardView>