<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:saveEnabled="true"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/imageUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:id="@+id/languages"
            android:focusable="true"
            app:strokeColor="@color/DarkTop"
            android:backgroundTint="@color/PagerBack"
            android:clickable="true"
            android:layout_centerHorizontal="true"
            android:layout_marginVertical="5dp"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:tint="@color/darkGreen"
                    android:alpha="0.8"
                    android:src="@drawable/language"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:alpha="0.8"
                    android:textStyle="bold"
                    android:layout_marginStart="3dp"
                    android:textColor="@color/darkGreen"
                    android:text="@string/languages"
                    android:textAllCaps="false"
                    />

            </LinearLayout>



        </com.google.android.material.card.MaterialCardView>




        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_marginHorizontal="20dp"
            android:layout_below="@id/languages"
            android:id="@+id/mainCard"
            app:strokeColor="@color/DarkTop"
            android:backgroundTint="@color/PagerBack"
            app:strokeWidth="2dp"
            android:layout_above="@id/indexCard"
            app:cardCornerRadius="30dp"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="match_parent">

                <ImageButton
                    android:id="@+id/backBtn"
                    android:layout_width="48dp"
                    android:backgroundTint="@android:color/transparent"
                    android:src="@drawable/arrow_back"
                    android:layout_height="48dp"
                    app:tint="@color/LightGreen"
                    android:visibility="gone"/>

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/pager"
                    android:contentDescription="@string/fill_form"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

            </LinearLayout>



        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_above="@id/Button"
            android:id="@+id/indexCard"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/index_1"
                android:layout_margin="2dp"
                app:strokeColor="@color/DarkTop"
                android:layout_width="15dp"
                android:layout_height="15dp"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/index_2"
                android:layout_margin="2dp"
                android:layout_width="15dp"
                app:strokeColor="@color/DarkTop"
                android:layout_height="15dp"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/index_3"
                android:layout_width="15dp"
                app:strokeColor="@color/DarkTop"
                android:layout_margin="2dp"
                android:layout_height="15dp"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/index_4"
                android:layout_margin="2dp"
                app:strokeColor="@color/DarkTop"
                android:layout_width="15dp"
                android:layout_height="15dp"/>
        </LinearLayout>
        <Button
            android:id="@+id/Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_marginBottom="5dp"
            android:layout_above="@id/terms"
            />
        <LinearLayout
            android:id="@+id/terms"
            android:layout_marginBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/privary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:focusable="true"
                android:textStyle="bold"
                android:textColor="@android:color/holo_blue_light"
                android:gravity="center_vertical"
                android:text="@string/privacy_policy"
                android:clickable="true"
                android:textSize="12sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layout_margin="3dp"
                android:text="|"
                />
            <TextView
                android:id="@+id/services"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:focusable="true"
                android:textColor="@android:color/holo_blue_light"
                android:textStyle="bold"
                android:textSize="12sp"
                android:gravity="center_vertical"
                android:text="@string/terms_of_service"
                android:clickable="true"/>

        </LinearLayout>

    </RelativeLayout>




</LinearLayout>