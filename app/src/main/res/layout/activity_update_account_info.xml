<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Update_Account_Info">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            style="@style/Base.Widget.Material3.CollapsingToolbar."
            app:layout_scrollFlags="scroll|enterAlways|enterAlwaysCollapsed|snap"
            android:layout_height="300dp"
            >
            <ImageView
                android:layout_width="match_parent"
                android:scaleType="centerCrop"
                android:id="@+id/ImageProfile"
                app:layout_collapseMode="parallax"
                android:layout_height="match_parent"/>
            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="wrap_content"
                app:layout_collapseMode="pin"
                app:title="Thabelo"
                android:id="@+id/toolBar"
                app:titleTextColor="@color/white"
                app:navigationIcon="@drawable/arrow_back"
                android:layout_height="?android:actionBarSize"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:hint="@string/email"
                    android:maxWidth="488dp"
                    android:layout_centerVertical="true"
                    android:isCredential="true"
                    app:hintAnimationEnabled="true"
                    android:enabled="false"
                    app:boxStrokeColor="@color/darkGreen"
                    android:textColorHint="@color/darkGreen"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/updateEmail"
                    android:id="@+id/emailHolder"
                    app:startIconTint="@color/darkGreen"
                    app:startIconDrawable="@drawable/email"
                    android:layout_marginHorizontal="30dp"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:inputType="text"
                        android:textColor="@color/LightGreen"
                        android:id="@+id/email"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:autofillHints="emailAddress"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:padding="0dp"
                    android:id="@+id/updateEmail"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="10dp"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="5dp"
                    style="@style/CardView.Edit.Update"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        style="@style/Base.Widget.AppCompat.ImageButton.Edit"
                        android:padding="0dp"
                        android:layout_margin="1dp"
                        android:layout_height="wrap_content">
                        <ImageButton
                            android:layout_width="wrap_content"
                            android:layout_gravity="end"
                            android:id="@+id/Updateemailar"
                            android:src="@drawable/edit"
                            style="@style/Base.Widget.AppCompat.ImageButton.Edit"
                            android:layout_height="wrap_content"/>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>






            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:hint="*******************************"
                    android:maxWidth="488dp"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/updatePasswordCard"
                    android:layout_centerVertical="true"
                    app:boxStrokeColor="@color/darkGreen"
                    android:textColorHint="@color/darkGreen"
                    app:hintAnimationEnabled="true"
                    android:enabled="false"
                    android:id="@+id/passwordHolder"
                    app:startIconTint="@color/darkGreen"
                    app:startIconDrawable="@drawable/lock"
                    android:layout_marginHorizontal="30dp"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:inputType="text"
                        android:textColor="@color/LightGreen"
                        android:id="@+id/password"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:autofillHints="emailAddress"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:padding="0dp"
                    android:id="@+id/updatePasswordCard"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="10dp"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="5dp"
                    style="@style/CardView.Edit.Update"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        style="@style/Base.Widget.AppCompat.ImageButton.Edit"
                        android:padding="0dp"
                        android:layout_margin="1dp"
                        android:layout_height="wrap_content">
                        <ImageButton
                            android:layout_width="wrap_content"
                            android:layout_gravity="end"
                            android:id="@+id/updatePassword"
                            android:src="@drawable/edit"
                            style="@style/Base.Widget.AppCompat.ImageButton.Edit"
                            android:layout_height="wrap_content"/>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>







            </RelativeLayout>



        </LinearLayout>



    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_marginEnd="10dp"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_gravity="bottom"
        android:layout_height="wrap_content">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:contentDescription="@string/signout"
            android:src="@drawable/round_exit"
            android:id="@+id/signOut"
            android:layout_marginBottom="10dp"
            style="@style/Base.Widget.Material3.FloatingActionButton."
            android:layout_height="wrap_content"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:contentDescription="@string/delete_account_"
            android:src="@drawable/delete"
            android:id="@+id/deleteAccount"
            style="@style/Base.Widget.Material3.FloatingActionButton."
            android:layout_height="wrap_content"/>
    </LinearLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>