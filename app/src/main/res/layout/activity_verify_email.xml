<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".Authentication.Reset_Password">
    <Space
        android:layout_width="wrap_content"
        android:layout_height="50dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_marginTop="20dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:fontFamily="@font/gothamroundedmedium"
        android:textAllCaps="false"
        android:contextClickable="false"
        android:text="@string/verify_email"
        android:layout_height="wrap_content"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:fontFamily="@font/gothamroundedmedium"
        android:textColor="@color/darkGreen"
        android:textSize="12sp"
        android:text="thabelonevhuduli@gmail.com"
        android:id="@+id/email"
        android:textAllCaps="false"
        android:contextClickable="false"
        android:layout_marginHorizontal="30dp"
        android:layout_height="wrap_content"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:text="@string/an_email_was_sent_to_above_email_address_with_instructions_to_verify_your_email_please_follow_instruction_to_continue"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:contextClickable="false"
        android:layout_marginHorizontal="30dp"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        android:layout_height="wrap_content">





        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:id="@+id/ok"
            android:textColor="@color/white"
            android:backgroundTint="@color/darkGreen"
            android:textAllCaps="false"
            android:text="@string/Ok"/>










    </LinearLayout>

</LinearLayout>