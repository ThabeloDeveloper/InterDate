<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:paddingBottom="50dp"
    style="@style/BottomSheetEditLinearLayout"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="18sp"
        android:fontFamily="@font/gothamroundedmedium"
        android:layout_gravity="center_horizontal"
        android:text="@string/app_name"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:textSize="13sp"
        android:layout_marginTop="3dp"
        android:layout_gravity="center_horizontal"
        android:text="@string/version_displayed"/>
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        app:cardCornerRadius="10dp"
        android:backgroundTint="@color/LightGreen"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="100dp"
            android:layout_height="100dp">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/new_icon"
                android:layout_centerInParent="true"/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="29dp"
                android:layout_centerVertical="true"
                android:src="@drawable/new_love"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:layout_width="wrap_content">
        <ImageView
            android:layout_height="12dp"
            android:layout_width="12dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/baseline_copyright"
            app:tint="@color/Gray" />

        <TextView
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_marginStart="5dp"
            android:text="@string/copy_right_year"
            android:layout_width="wrap_content"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:textSize="11sp"
        android:layout_marginTop="3dp"
        android:layout_height="wrap_content"
        android:text="@string/by"/>
    <TextView
        android:layout_width="wrap_content"
        android:textSize="11sp"
        android:layout_marginTop="3dp"
        android:layout_height="wrap_content"
        android:text="Mecaroid (Pty) Ltd"/>

    <TextView
        android:layout_width="wrap_content"
        android:textSize="11sp"
        android:layout_marginTop="5dp"
        android:layout_height="wrap_content"
        android:text="@string/south_africa"/>



</LinearLayout>