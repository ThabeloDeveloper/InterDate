<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InformationPages.LocationInformation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp"
        android:orientation="vertical">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/location_information"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginVertical="20dp"
            android:textSize="18sp"
            android:layout_marginStart="10dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/country"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            android:isCredential="true"
            app:startIconDrawable="@drawable/my_location"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text|textPostalAddress"
                android:id="@+id/country"
                android:textColor="@color/white"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/state"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            android:isCredential="true"
            android:layout_marginTop="30dp"
            app:startIconDrawable="@drawable/my_location"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text|textPostalAddress"
                android:id="@+id/state"
                android:textColor="@color/white"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/city"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            android:isCredential="true"
            android:layout_marginTop="30dp"
            app:startIconDrawable="@drawable/city"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text|textPostalAddress"
                android:id="@+id/city"
                android:textColor="@color/white"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/town"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            android:isCredential="true"
            android:layout_marginTop="30dp"
            app:startIconDrawable="@drawable/my_location"
            app:startIconTint="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text|textPostalAddress"
                android:id="@+id/town"
                android:textColor="@color/white"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:layout_marginHorizontal="10dp"
            android:text="@string/arewillrelo"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:layout_height="wrap_content">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="wrap_content"
                android:text="@string/yes"
                android:textColor="@color/white"
                android:id="@+id/YesRelocate"
                android:layout_height="wrap_content"/>
            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="wrap_content"
                android:text="@string/no"
                android:textColor="@color/white"
                android:id="@+id/NoRelocating"
                android:layout_marginStart="10dp"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>