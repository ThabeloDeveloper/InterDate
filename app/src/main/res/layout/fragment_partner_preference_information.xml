<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".InformationPages.PartnerPreferenceInformation">


    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:maxWidth="488dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/partner_preference"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginVertical="20dp"
            android:textSize="18sp"
            android:layout_marginStart="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColor="@color/white"
            android:layout_marginHorizontal="10dp"
            android:text="@string/age"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:maxWidth="488dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:hint="@string/from"
                app:hintAnimationEnabled="true"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                app:boxStrokeColor="@color/darkGreen"
                app:hintTextColor="@color/darkGreen"
                android:textColorHint="@color/darkGreen"
                android:layout_marginHorizontal="10dp"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="numberDecimal"
                    android:minWidth="100dp"
                    android:id="@+id/age_from"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textColor="@color/darkGreen"
                android:layout_marginBottom="20dp"
                android:text="--->"/>



            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:hint="@string/to"
                android:layout_centerVertical="true"
                app:hintAnimationEnabled="true"
                android:layout_alignParentEnd="true"
                app:boxStrokeColor="@color/darkGreen"
                app:hintTextColor="@color/darkGreen"
                android:textColorHint="@color/darkGreen"
                android:layout_marginHorizontal="10dp"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="numberDecimal"
                    android:minWidth="100dp"
                    android:textColor="@color/white"
                    android:id="@+id/age_to"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="10dp"
            android:text="@string/gender"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:hint="@string/gender"
                app:hintAnimationEnabled="true"
                android:enabled="false"
                app:boxStrokeColor="@color/darkGreen"
                android:layout_toStartOf="@+id/preferedGen"
                android:layout_centerVertical="true"
                app:startIconDrawable="@drawable/gender_icon"
                app:startIconTint="@color/darkGreen"
                android:maxWidth="488dp"
                android:textColorHint="@color/darkGreen"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="text"
                    android:textColor="@color/white"
                    android:id="@+id/prefered_gender"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.Toolbar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/preferedGen"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:menu="@menu/gender"
                />
        </RelativeLayout>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="10dp"
            android:text="@string/race"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:hint="@string/race"
                app:hintAnimationEnabled="true"
                app:boxStrokeColor="@color/darkGreen"

                android:enabled="false"
                android:layout_toStartOf="@+id/preffereace"
                android:layout_centerVertical="true"
                app:startIconDrawable="@drawable/race"
                app:startIconTint="@color/darkGreen"
                app:hintTextColor="@color/darkGreen"
                android:textColorHint="@color/darkGreen"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="text"
                    android:textColor="@color/white"
                    android:id="@+id/preffered_race"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.Toolbar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/preffereace"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:menu="@menu/per_race"
                />
        </RelativeLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="10dp"
            android:text="@string/religion"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/religion"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            app:startIconDrawable="@drawable/pray"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:textColor="@color/white"
                android:id="@+id/preffred_religion"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="10dp"
            android:text="@string/re_locate"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/willing_re_locate_yes_no"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            app:startIconDrawable="@drawable/my_location"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:textColor="@color/white"
                android:id="@+id/preffred_re_locate"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="10dp"
            android:text="@string/patner_baciclly"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/bacically_looking_for"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            app:startIconDrawable="@drawable/info"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:textColor="@color/white"
                android:id="@+id/bacically_looking_for"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>



</ScrollView>