<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/scrollView"
    tools:context=".InformationPages.PersonalInformation">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:paddingBottom="30dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/personal_information"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginVertical="20dp"
            android:textSize="18sp"
            android:layout_marginStart="10dp"/>

        <RelativeLayout
            android:layout_width="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_height="150dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                app:cardCornerRadius="30dp"
                app:strokeColor="@color/LightGreen"
                android:clickable="true"
                android:focusable="true"
                android:backgroundTint="@color/DarkTop"
                android:layout_height="match_parent">


                <ImageView
                    android:layout_width="match_parent"
                    android:src="@drawable/baseline_account"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:id="@+id/profile_Pic"

                    />


            </com.google.android.material.card.MaterialCardView>



        </RelativeLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/names"
            android:isCredential="true"
            android:layout_marginTop="20dp"
            app:startIconDrawable="@drawable/person_create"
            app:startIconTint="@color/darkGreen"
            app:boxStrokeColor="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            app:hintAnimationEnabled="true"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:id="@+id/names"
                android:textColor="@color/white"
                android:autofillHints="name"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/age"
            android:layout_marginTop="30dp"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            android:isCredential="true"
            app:startIconDrawable="@drawable/round_elderly"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="numberDecimal"
                android:id="@+id/age"
                android:textColor="@color/white"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="30dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:hint="@string/gender"
                android:enabled="false"
                app:hintAnimationEnabled="true"
                app:boxStrokeColor="@color/darkGreen"
                android:isCredential="true"
                android:layout_toStartOf="@+id/userGender"
                android:layout_centerVertical="true"
                app:startIconDrawable="@drawable/gender_icon"
                app:startIconTint="@color/darkGreen"
                android:textColorHint="@color/darkGreen"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="text"
                    android:id="@+id/gender"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.Toolbar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/userGender"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:menu="@menu/gender"
                />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="30dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:hint="@string/race"
                android:enabled="false"
                app:hintAnimationEnabled="true"
                app:boxStrokeColor="@color/darkGreen"
                android:isCredential="true"
                android:layout_toStartOf="@+id/userRace"
                android:layout_centerVertical="true"
                app:startIconDrawable="@drawable/race"
                app:startIconTint="@color/darkGreen"
                android:textColorHint="@color/darkGreen"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="text"
                    android:id="@+id/race"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.Toolbar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/userRace"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:menu="@menu/race"
                />
        </RelativeLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/religion"
            android:layout_marginTop="30dp"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            android:isCredential="true"
            app:startIconDrawable="@drawable/pray"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:textColor="@color/white"
                android:id="@+id/religion"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/languages"
            android:layout_marginTop="30dp"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            android:isCredential="true"
            app:startIconDrawable="@drawable/language"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:textColor="@color/white"
                android:id="@+id/languages"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/occupations"
            android:layout_marginTop="30dp"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            app:startIconDrawable="@drawable/work"
            app:startIconTint="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:textColor="@color/white"
                android:id="@+id/occupations"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/hobbies"
            android:layout_marginTop="30dp"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            app:startIconDrawable="@drawable/sports_handball"
            app:startIconTint="@color/darkGreen"
            app:hintTextColor="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:textColor="@color/white"
                android:id="@+id/hobbies"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:hint="@string/about"
            android:layout_marginTop="30dp"
            app:hintAnimationEnabled="true"
            app:boxStrokeColor="@color/darkGreen"
            app:startIconDrawable="@drawable/info"
            app:startIconTint="@color/darkGreen"
            android:textColorHint="@color/darkGreen"
            android:layout_marginHorizontal="10dp"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:inputType="text"
                android:id="@+id/about"
                android:textColor="@color/white"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:layout_marginHorizontal="10dp"
            android:text="@string/do_you_have_children"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:layout_height="wrap_content">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="wrap_content"
                android:text="@string/yes"
                android:textColor="@color/white"
                android:id="@+id/haveKid"
                android:layout_height="wrap_content"/>
            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="wrap_content"
                android:text="@string/no"
                android:textColor="@color/white"
                android:id="@+id/NothaveKid"
                android:layout_marginStart="10dp"
                android:layout_height="wrap_content"/>

        </LinearLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/kidsHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="20dp"
            android:hint="@string/how_many"
            android:isCredential="true"
            android:textColorHint="@color/darkGreen"
            android:visibility="visible"
            app:boxStrokeColor="@color/darkGreen"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/darkGreen"
            app:startIconDrawable="@drawable/children"
            app:startIconTint="@color/darkGreen">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/kidsNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/white"
                android:visibility="visible" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>



</ScrollView>