<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        style="@style/CardView.Light."
        android:clickable="true"
        android:focusable="true"
        app:strokeWidth="0dp"
        android:elevation="0dp"
        android:id="@+id/RealLayout"
        android:visibility="gone"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_height="wrap_content">



            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_margin="5dp"
                android:layout_gravity="center_vertical"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="500dp"
                android:layout_height="48dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:src="@drawable/person"
                        android:id="@+id/profile"
                        android:scaleX="0.0"
                        android:scaleY="0.0"
                        android:scaleType="center"
                        android:layout_height="match_parent"
                        android:contentDescription="profile" />


                </RelativeLayout>



            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/username"
                        android:layout_width="wrap_content"
                        android:text="Thabelo Nevhuduli"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        style="@style/Base.Widget.AppCompat.TextView"
                        android:layout_marginBottom="3dp"
                        android:layout_height="wrap_content"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/turn_card"
                        android:layout_width="wrap_content"
                        app:cardElevation="0dp"
                        android:layout_marginStart="5dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/LightGreen"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="1dp"
                            android:layout_marginHorizontal="3dp"
                            android:fontFamily="@font/centurygothic_bold"
                            android:textSize="12sp"
                            android:text="Your turn"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>





                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="15dp"
                        android:src="@drawable/sent"
                        android:id="@+id/status"
                        android:layout_height="15dp"/>



                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Hey i will be back by Monday"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:maxWidth="150dp"
                        android:ellipsize="marquee"
                        android:layout_marginEnd="20dp"
                        android:id="@+id/lastMessage"
                        android:textStyle="bold"
                        android:layout_marginStart="3dp"
                        android:layout_height="wrap_content"/>
                </LinearLayout>







            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.Toolbar
                    android:layout_width="25dp"
                    android:layout_marginEnd="10dp"
                    android:layout_alignParentEnd="true"
                    app:menu="@menu/chat_menu"
                    android:id="@+id/chat_menu"
                    android:layout_height="25dp"
                    android:layout_gravity="end"/>
            </RelativeLayout>





        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:id="@+id/shima"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                style="@style/CardView.Light."
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_margin="5dp"
                        android:layout_gravity="center_vertical"
                        android:backgroundTint="@color/white"
                        app:cardCornerRadius="500dp"
                        android:layout_height="48dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:src="@drawable/person"

                                android:foreground="@color/Gray"
                                android:scaleType="center"
                                android:layout_height="match_parent"
                                android:contentDescription="profile" />


                        </RelativeLayout>



                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="5dp"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content">

                        <TextView

                            android:layout_width="match_parent"
                            android:text="Thabelo Nevhuduli"
                            android:textSize="16sp"
                            android:layout_marginEnd="50dp"
                            android:textColor="@color/Gray"
                            android:background="@color/Gray"
                            android:textStyle="bold"
                            style="@style/Base.Widget.AppCompat.TextView"
                            android:layout_marginBottom="3dp"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:text="Hey i will be back by Monday"
                            android:textSize="14sp"
                            android:layout_marginEnd="50dp"
                            android:textColor="@color/Gray"
                            android:background="@color/Gray"

                            android:textStyle="bold"
                            android:layout_height="wrap_content"/>




                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>




</RelativeLayout>