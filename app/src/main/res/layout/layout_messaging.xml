<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginTop="7dp"
    android:layout_marginHorizontal="5dp"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:id="@+id/recicevedLayout"
        android:visibility="gone"
        android:layout_marginEnd="150dp"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="30dp"
            android:id="@+id/ImageCard"
            android:layout_marginTop="3dp"
            app:cardCornerRadius="500dp"
            style="@style/MessagesReceived."
            android:layout_height="30dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/baseline_account_circle_24"
                />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="start"
            android:layout_toEndOf="@id/ImageCard"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/receivedText"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Hey World"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                style="@style/MessagesReceived."
                />

        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:id="@+id/sentLayout"
        android:layout_gravity="end"
        android:visibility="visible"
        android:layout_marginStart="100dp"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="30dp"
            android:id="@+id/Image2Card"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="3dp"
            style="@style/MessagesSent."
            app:cardCornerRadius="500dp"
            android:layout_height="30dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/baseline_account_circle_24"
                />

        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="5dp"
            android:layout_gravity="start"
            android:layout_toStartOf="@id/Image2Card"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="wrap_content"
                style="@style/MessagesSent."
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:padding="7dp"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Hello"
                        android:id="@+id/sentText"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="3dp"
                        android:id="@+id/status"
                        android:src="@drawable/done_all_del"
                        android:layout_height="15dp"
                        android:layout_alignParentEnd="true"/>

                </LinearLayout>



            </RelativeLayout>
        </LinearLayout>

    </RelativeLayout>

</LinearLayout>