<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/CardView.Light.NEW"
    android:layout_width="match_parent"
    android:id="@+id/cardWith"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginHorizontal="5dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:orientation="vertical"
    app:cardCornerRadius="10dp"
    android:elevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/CardView.Light.NEW"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            app:cardCornerRadius="5dp"
            android:elevation="0dp"
            app:strokeWidth="0dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:id="@+id/profileImage"
                    android:contentDescription="TODO"
                    android:layerType="software"
                    android:layout_gravity="bottom|end"
                    android:scaleType="center"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:layout_width="30dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="2dp"
                    android:id="@+id/verify"
                    android:contentDescription="TODO"
                    android:src="@drawable/verified_account"
                    android:layout_height="30dp"
                    app:tint="@android:color/darker_gray" />
                <LinearLayout
                    android:layout_margin="5dp"
                    android:layout_alignParentBottom="true"
                    android:layout_width="wrap_content"
                    android:hapticFeedbackEnabled="true"
                    android:paddingVertical="1dp"
                    android:alpha="0.7"
                    android:paddingHorizontal="5dp"
                    android:background="@drawable/distance_background"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/distanceText"
                        android:fontFamily="@font/centurygothic"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unknown"
                        android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_margin="5dp"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:hapticFeedbackEnabled="true"
                    android:paddingVertical="1dp"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:background="@drawable/distance_background"
                    android:layout_height="wrap_content">
                    <TextView
                        android:fontFamily="@font/centurygothic"
                        android:id="@+id/age_from_to"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~"
                        android:textStyle="bold"/>
                </LinearLayout>


            </RelativeLayout>


        </com.google.android.material.card.MaterialCardView >
        <TextView
            android:id="@+id/username"
            style="@style/Base.Widget.AppCompat.TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="marquee"
            android:maxWidth="150dp"
            android:maxLines="1"
            android:fontFamily="@font/centurygothic_bold"
            android:text="Thabelo Nevhuduli"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/country"
                style="@style/Base.Widget.AppCompat.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="marquee"
                android:maxWidth="140dp"
                android:maxLines="1"
                android:fontFamily="@font/centurygothic_bold"
                android:text="South Africa"
                android:textSize="12sp"
                />
            <TextView
                android:id="@+id/age"
                android:fontFamily="@font/centurygothic_bold"
                style="@style/Base.Widget.AppCompat.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:maxWidth="140dp"
                android:layout_gravity="center_vertical"
                android:maxLines="1"
                android:text="20"
                android:layout_marginStart="5dp"
                android:textSize="12sp"
                android:textStyle="bold" />
            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:backgroundTint="@color/Gray"
                android:id="@+id/onlineStatus"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="7dp"
                app:cardCornerRadius="100dp"/>

        </LinearLayout>

        <TextView
            android:fontFamily="@font/centurygothic"
            android:layout_width="140dp"
            android:maxWidth="200dp"
            android:textSize="10sp"
            android:id="@+id/cityandtown"
            android:maxLines="2"
            android:ellipsize="marquee"
            android:layout_marginTop="2dp"
            android:text="Limpopo,Nzhelele"
            android:layout_height="wrap_content"/>
        <ProgressBar
            android:id="@+id/progress_bar"
            app:trackColor="@color/PagerBack"
            android:indeterminateTint="@color/darkGreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:outlineProvider="paddedBounds"
            app:indeterminateAnimationType="disjoint"
            android:layout_marginVertical="5dp"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>



    </LinearLayout>


</com.google.android.material.card.MaterialCardView>