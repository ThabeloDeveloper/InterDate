                    android:text="@string/semi_medium_credits"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="marquee"
                    android:text="@string/interact_with_app_with_our_medium_cost_credits"
                    android:textStyle="normal"
                    android:textSize="12sp"
                    />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="$21.99/750"
                android:layout_toStartOf="@id/SemimediumBuy"
                android:id="@+id/SemimediumPriceText"
                android:textColor="@color/darkGreen"
                android:layout_marginHorizontal="5dp"
                android:layout_height="wrap_content"/>

            <Button
                android:layout_width="75dp"
                android:id="@+id/SemimediumBuy"
                android:text="Buy"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:textColor="@color/white"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

    </LinearLayout>
    <LinearLayout
