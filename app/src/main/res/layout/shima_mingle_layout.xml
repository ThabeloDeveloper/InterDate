<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/CardView.Light.NEW"
    android:layout_width="match_parent"
    android:id="@+id/cardWith"
    android:layout_marginHorizontal="5dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:orientation="vertical"
    app:cardCornerRadius="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <androidx.cardview.widget.CardView
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:foregroundTint="@color/Gray"
            app:cardCornerRadius="5dp">
            <ImageView
                android:layout_width="match_parent"
                android:id="@+id/profileImage"
                android:layerType="software"
                android:foreground="@color/Gray"
                android:background="@color/Gray"
                android:scaleType="center"
                android:layout_height="match_parent"/>

        </androidx.cardview.widget.CardView>






        <TextView
            android:id="@+id/username"
            style="@style/Base.Widget.AppCompat.TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="marquee"
            android:maxWidth="150dp"
            android:textColor="@color/Gray"
            android:background="@color/Gray"
            android:maxLines="1"
            android:text="Thabelo Nevhuduli"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/country"
                style="@style/Base.Widget.AppCompat.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:layout_marginVertical="3dp"
                android:maxWidth="140dp"
                android:textColor="@color/Gray"
                android:background="@color/Gray"
                android:maxLines="1"
                android:layout_gravity="center_vertical"
                android:text="South Africa"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/age"
                style="@style/Base.Widget.AppCompat.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:maxWidth="140dp"
                android:textColor="@color/Gray"
                android:background="@color/Gray"
                android:layout_gravity="center_vertical"
                android:maxLines="1"
                android:text="20"
                android:layout_marginStart="5dp"
                android:textSize="12sp"
                android:textStyle="bold" />
            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:backgroundTint="@color/Gray"
                android:id="@+id/onlineStatus"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="7dp"
                app:cardCornerRadius="100dp"/>

        </LinearLayout>
        <TextView
            android:layout_width="140dp"
            android:maxWidth="200dp"
            android:textSize="10sp"
            android:textColor="@color/Gray"
            android:background="@color/Gray"
            android:id="@+id/cityandtown"
            android:layout_marginTop="2dp"
            android:text="Limpopo,Nzhelele"
            android:layout_height="wrap_content">

        </TextView>
    </LinearLayout>


</androidx.cardview.widget.CardView>