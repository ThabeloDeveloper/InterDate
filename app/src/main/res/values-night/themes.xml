    </style>

    <style name="LayoutSubBack" parent="Theme.AppCompat.DayNight">
        <item name="android:background">@drawable/background</item>
    </style>

    <style name="sub_back_gradient" parent="Theme.AppCompat.DayNight">
        <item name="android:background">@drawable/gradient_backgraund</item>

    </style>

    <style name="navigation" parent="Theme.AppCompat">
        <item name="android:background">@color/PagerBack</item>
        <item name="itemIconTint">@color/nav_item_color_dark</item>
        <item name="itemRippleColor">@color/LightGreen</item>
        <item name="itemTextColor">@color/nav_item_color_dark</item>
    </style>

    <style name="divider" parent="Theme.AppCompat">
