<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.InterDate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/LightGreen</item>
        <item name="popupMenuBackground">@drawable/popup_menu_all_light</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:progressTint">@color/darkGreen</item>

        <item name="alertDialogStyle">@style/CustomProgressDialogStyle</item>
        <item name="popupMenuStyle">@style/Base.Widget.AppCompat.PopupMenu</item>

        <item name="android:dialogCornerRadius">35dp</item>
        <item name="textColorAlertDialogListItem">@color/LightGreen</item>


        <!-- Customize your light theme here. -->
        <item name="android:statusBarColor">@color/LightGreen</item>


        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="BottomSheetEditLinearLayout" parent="Theme.AppCompat">
        <item name="android:textColor">@color/darkGreen</item>
        <item name="android:background">@drawable/bottom_sheet_authentication_back_light</item>

    </style>

    <style name="Theme.AppCompat.Light." parent="Theme.AppCompat.Light">
        <item name="android:background">@color/messagingBackLight</item>
    </style>


    <style name="Base.Widget.AppCompat.EditText." parent="Base.Widget.AppCompat.EditText">
        <item name="android:background">@color/white</item>
    </style>

    <style name="TextAppearance.AppCompat." parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/LightGreen</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="Base.Theme.InterDate.Authentication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/LightGreen</item>
        <item name="android:progressTint">@color/darkGreen</item>
        <item name="android:textColor">@color/LightGreen</item>
        <item name="bottomSheetStyle">@style/Theme.Design.BottomSheetDialog</item>
        <item name="android:colorBackground">@color/PagerBack</item>
        <item name="android:dialogCornerRadius">35dp</item>
        <item name="popupMenuBackground">@drawable/popup_menu_all_dark</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu.ContextMenu</item>
        <item name="textColorAlertDialogListItem">@color/LightGreen</item>
        <!-- Customize your light theme here. -->
        <item name="android:statusBarColor">@color/DarkTop</item>


        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>


    <style name="Base.Widget.Material3.CollapsingToolbar." parent="Base.Widget.Material3.CollapsingToolbar">
        <item name="contentScrim">@color/LightGreen</item>
        <item name="collapsedTitleTextColor">@color/white</item>
        <item name="expandedTitleTextColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="titleTextStyle">@style/TextAppearance.Material3.BodyLarge</item>
    </style>

    <style name="PagerHome." parent="Theme.Design.Light.NoActionBar">
        <item name="android:background">@color/white</item>
    </style>

    <style name="LayoutSave." parent="Theme.AppCompat">
        <item name="android:background">@drawable/saving_layout_back</item>
    </style>

    <style name="Theme.InterDate" parent="Base.Theme.InterDate" />

    <style name="Theme.InterDate.TabLayout" parent="Widget.MaterialComponents.TabLayout.PrimarySurface">
        <item name="android:background">@color/LightGreen</item>
        <item name="tabGravity">center</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIconTint">@color/home_tab_icon_light</item>
        <item name="tabPaddingBottom">3dp</item>
        <item name="tabPadding">3dp</item>
        <item name="tabTextAppearance">@style/TextAppearance.AppCompat.TabHome</item>
        <item name="tabRippleColor">@color/darkGreen</item>
        <item name="tabSelectedTextAppearance">@style/TextAppearance.AppCompat.TabHome</item>
        <item name="android:backgroundTint">@color/LightGreen</item>
        <item name="tabTextColor">@color/LightTapText</item>
        <item name="tabIndicatorColor">@color/white</item>


    </style>

    <style name="TextAppearance.AppCompat.TabHome" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/gothamroundedmedium</item>
        <item name="android:textSize">16sp</item>

    </style>

    <style name="Base.Widget.Material3.FloatingActionButton." parent="ThemeOverlay.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/LightGreen</item>

    </style>

    <style name="Base.Widget.AppCompat.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CardView.Light." parent="CardView.Light">
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="CardView.Light.UserDetails" parent="CardView.Light">
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="CardView.Light.UserDetails." parent="CardView.Light">
        <item name="android:backgroundTint">@color/LightGreen</item>
        <item name="cardElevation">50dp</item>

    </style>

    <style name="Base.Widget.AppCompat.ImageView.Chat" parent="Base.Widget.AppCompat.ImageView">
        <item name="android:background">@color/white</item>


    </style>

    <style name="MessagesSent." parent="Base.Widget.AppCompat.TextView">
        <item name="android:backgroundTint">@color/sentLight</item>
        <item name="android:background">@drawable/messege_sent_background_light</item>
        <item name="android:fontFamily">@font/gothamroundedmedium</item>
        <item name="android:elevation">10dp</item>
    </style>

    <style name="MessagesReceived." parent="Base.Widget.AppCompat.TextView">
        <item name="android:backgroundTint">@color/receivedLight</item>
        <item name="android:background">@drawable/messege_background</item>
        <item name="android:fontFamily">@font/gothamroundedmedium</item>
        <item name="android:elevation">10dp</item>
    </style>

    <style name="CardView.Light.ImageHolder" parent="CardView.Light">
        <item name="android:backgroundTint">@color/Gray</item>
    </style>

    <style name="CardView.Light.NEW" parent="CardView.Light">
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="MaterialBtnConfirm" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/LightGreen</item>

    </style>

    <style name="CardView.Type" parent="CardView.Light">
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="CardView.Edit" parent="CardView.Light">

        <item name="android:backgroundTint">@color/white</item>
        <item name="android:background">@color/white</item>
    </style>
    ////////////////////////

    <style name="ImageButtonStyle." parent="Widget.AppCompat.ImageButton">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:tint">@color/darkGreen</item>

    </style>
    /////////////////////////////////

    <style name="Widget.AppCompat.EditText." parent="Widget.AppCompat.EditText">
        <item name="android:textColorHint">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>
    //////////////////////////////////
    //////////////////////////////////////
    ////////////////////////////////////////////

    <style name="Theme.InterDate.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/LightGreen</item>
        <item name="iconTint">@color/white</item>
        <item name="android:tint">@color/white</item>
        <item name="android:fontFamily">@font/gothamroundedmedium</item>
        <item name="tint">@color/white</item>
        <item name="android:titleTextStyle">@style/TextAppearance.AppCompat..</item>
        <item name="android:titleTextColor">@color/white</item>
    </style>

    <style name="Theme.InterDate.materialCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:strokeColor">@color/white</item>
        <item name="strokeColor">@color/darkGreen</item>
        <item name="cardElevation">10dp</item>
        <item name="android:backgroundTint">@color/white</item>

    </style>

    <style name="Base.Widget.AppCompat.ImageView." parent="Base.Widget.AppCompat.ImageView">

        <item name="android:tint">@color/darkGreen</item>
    </style>
    //////////////////////////////////

    <style name="TextAppearance.AppCompat.." parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/gothamroundedmedium</item>
    </style>
    //////////////////////////////

    <style name="Base.Widget.AppCompat.ImageButton." parent="Base.Widget.AppCompat.ImageButton">

        <item name="android:backgroundTint">@color/LightGreen</item>

    </style>
    ///////////////////////////////////////

    <style name="Base.Widget.AppCompat.ImageButton.Edit" parent="Base.Widget.AppCompat.ImageButton">
        <item name="android:tint">@color/LightGreen</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>
    //////////////////////////

    <style name="CardView.Edit.Update" parent="CardView.Light">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:background">@color/white</item>
    </style>
    ////////////////////////////////////////

    <style name="Base.Widget.AppCompat.ImageView.Account." parent="Base.Widget.AppCompat.ImageButton.">
        <item name="android:tint">@color/LightGreen</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="CustomProgressDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:dialogCornerRadius">30dp</item>
        <item name="colorPrimary">@color/LightGreen</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomProgressDialogStyleButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomProgressDialogStyleButton</item>
        <item name="android:progressTint">@color/LightGreen</item>


    </style>

    <style name="CustomProgressDialogStyleButton" parent="ThemeOverlay.Material3.Light">
        <item name="textColorAlertDialogListItem">@color/LightGreen</item>
        <item name="android:textColor">@color/LightGreen</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:colorPrimary">@color/white</item>
        <item name="backgroundTint">@color/white</item>
        <item name="textAllCaps">false</item>
    </style>


    <style name="Base.Widget.AppCompat.ImageView" parent="Theme.AppCompat">
        <item name="android:tint">@color/LightGreen</item>
        <item name="android:indeterminateTint">@color/LightGreen</item>
        <item name="indeterminateProgressStyle">
            @style/Widget.MaterialComponents.LinearProgressIndicator
        </item>
    </style>

    <style name="CardView.BShit" parent="CardView.Light">
        <item name="android:backgroundTint">@color/Gray</item>
    </style>

    <style name="LayoutSubBack" parent="Theme.AppCompat.DayNight">
        <item name="android:background">@drawable/background_light</item>
    </style>

    <style name="sub_back_gradient" parent="Theme.AppCompat.DayNight">
        <item name="android:background">@drawable/gradient_background_light</item>

    </style>

    <style name="navigation" parent="Theme.AppCompat">
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/nav_item_color_light</item>
        <item name="itemRippleColor">@color/LightGreen</item>
        <item name="itemTextColor">@color/nav_item_color_light</item>
    </style>

    <style name="divider" parent="Theme.AppCompat">
        <item name="dividerColor">@color/black</item>
    </style>

    <style name="Theme.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="indicatorColor">@color/LightGreen</item>
        <item name="android:color">#D8FDD2</item>
    </style>


</resources>